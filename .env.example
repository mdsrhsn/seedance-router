# Copy to .env for local dev. On Railway, set these as service variables.

# Postgres connection string. Railway provides this automatically as DATABASE_URL.
DATABASE_URL=postgresql://user:pass@localhost:5432/seedance_router

# Flask session secret. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Encryption key for API keys stored in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: if this changes, every stored credential becomes unreadable. Back it up.
FERNET_KEY=change-me

# Dashboard login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Default ModelArk endpoint. Per-credential override is available in the UI.
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
